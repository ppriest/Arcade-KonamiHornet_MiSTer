# The whole board's area and Fmax, standalone (not the core build):
#     python scripts/synth_board_top.py
#     quartus_sh --flow compile rtl/synth_board/synth_board
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY synth_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"
set_global_assignment -name SEED 0
set_global_assignment -name SEARCH_PATH ../cpu/sharc2
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc/sharc_fp_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc2_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc_fadd.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc_fmul.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc2_alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc2_lutram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/sharc2/sharc2_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../cpu/ppc403/ppc403_core.sv
set_global_assignment -name SEARCH_PATH ../raster
set_global_assignment -name SYSTEMVERILOG_FILE ../raster/vraster.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_sdpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_rtc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_dpram2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_icache.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../board/hornet_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE synth_top.sv
set_global_assignment -name SDC_FILE synth_board.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"