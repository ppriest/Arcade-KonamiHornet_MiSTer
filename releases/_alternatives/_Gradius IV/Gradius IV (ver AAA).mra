<misterromdescription>
    <name>Gradius IV (ver AAA)</name>
    <setname>gradius4aa</setname>
    <rbf>KonamiHornet</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Konami</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>

    <!-- KonamiHornet.sv's download: program ROM 4 MB (the 2 MB ROM twice, as MAME's region),
         data ROM 8 MB, CG ROM 16 MB, M48T58 8 KB; then the sound board's 68000 program (512 KB)
         and samples (8 MB) as stored, which the HPS's sound server reads from DDR3 (the
         fast load); written and checked by scripts/gen_mra.py -->
    <rom index="0" zip="gradius4aa.zip|gradius4.zip" md5="none" address="0x30000000">
        <!-- program ROM: ROM_LOAD16_WORD_SWAP, reloaded -->
        <interleave output="16">
            <part name="837a01.27p" crc="6083ed08" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="837a01.27p" crc="6083ed08" map="12"/>
        </interleave>
        <!-- data ROM: ROM_LOAD32_WORD_SWAP, the first in bytes 0-1, the second in bytes 2-3 -->
        <interleave output="32">
            <part name="837a04.16t" crc="18453b59" map="0012"/>
            <part name="837a05.14t" crc="77178633" map="1200"/>
        </interleave>
        <part repeat="0x400000">00</part>
        <!-- CG ROM: ROM_LOAD32_WORD_SWAP pairs, the second at 8 MB -->
        <interleave output="32">
            <part name="837a13.24u" crc="d86e10ff" map="0012"/>
            <part name="837a14.32u" crc="ff1b5d18" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="837a15.24v" crc="e0620737" map="0012"/>
            <part name="837a16.32v" crc="bb7a7558" map="1200"/>
        </interleave>
        <!-- M48T58: the set's NVRAM image -->
        <part name="m48t58y-70pc1_aaa" crc="cc652d7c"/>
        <!-- ... with the settings its first boot writes (scripts/mame_nvram_setup.py): no RTC
             checksum error or clock screens. A saved .nvm replaces it -->
        <patch offset="0x1C00010">
            1e be 00 00 00 00 00 00 00 00 01 01 00 00 00 00
            14 00 00 00 00 00 00 00 03 00 03 01 00 00 00 00
            00 00 df d4 46 b5 b1 86 00 00 af c8 52 b5 b1 81
            00 00 9c 40 4e b6 31 84 00 00 88 b8 36 b8 b1 85
            00 00 75 30 36 b3 31 82 00 00 61 a8 2a b4 71 82
            00 00 4e 20 8a b5 f1 8b 00 00 3a 98 76 b2 b1 85
            00 00 27 10 5e b5 f1 81 00 00 13 88 5e b5 b1 84
        </patch>
        <!-- the sound board (MiSTer_ArcadeSoundServer): at 0x1C02000 and 0x1C82000, hornet_sndbridge's PROG and SAMPLES -->
        <part name="837a08.7s" crc="c3a7ff56"/>
        <part name="837a09.16p" crc="fb8f3dc2"/>
        <part name="837a10.14p" crc="1419cad2"/>
    </rom>
    <!-- the M48T58 saved and restored (KonamiHornet.sv, ioctl index 4) -->
    <nvram index="4" size="8192"/>

    <cheats size="16" max="16">
        <cheat name="Infinite Credits">000000001d4700000000000063000000</cheat>
        <cheat name="Select Gauge Position: None">000000006f4900000000000000000000</cheat>
        <cheat name="Select Gauge Position: Speed Up">000000006f4900000000000001000000</cheat>
        <cheat name="Select Gauge Position: Missile">000000006f4900000000000002000000</cheat>
        <cheat name="Select Gauge Position: Double">000000006f4900000000000003000000</cheat>
        <cheat name="Select Gauge Position: Laser">000000006f4900000000000004000000</cheat>
        <cheat name="Select Gauge Position: Option">000000006f4900000000000005000000</cheat>
        <cheat name="Select Gauge Position: ?">000000006f4900000000000006000000</cheat>
        <cheat name="Select Speed: 0">00000000861d0f000000000000000000</cheat>
        <cheat name="Select Speed: 1">00000000861d0f000000000001000000</cheat>
        <cheat name="Select Speed: 2">00000000861d0f000000000002000000</cheat>
        <cheat name="Select Speed: 3">00000000861d0f000000000003000000</cheat>
        <cheat name="Select Speed: 4">00000000861d0f000000000004000000</cheat>
        <cheat name="Select Speed: 5">00000000861d0f000000000005000000</cheat>
        <cheat name="Always Have Missile">010000009b1d0f000000000002000000</cheat>
        <cheat name="Always Have Double (Buggy)">010000009b1d0f000000000004000000</cheat>
        <cheat name="Always Have Laser (Buggy)">010000009b1d0f000000000008000000</cheat>
        <cheat name="Always Have Options">00000000851d0f000000000004000000</cheat>
        <cheat name="Infinite Force Field Energy">00000000871d0f000000000003000000</cheat>
        <cheat name="Unlocked 2nd Loop Start">00000000134900000000000001000000000000003b4900000000000001000000000000004f4900000000000001000000</cheat>
        <cheat name="Rapid Fire - Shot">000000009f1d0f000000000000000000</cheat>
        <cheat name="P1 Infinite Lives">00000000344900000000000009000000</cheat>
        <cheat name="P2 Infinite Lives">00000000484900000000000009000000</cheat>
    </cheats>

    <!-- MAME's defaults (0x7B) but Monitor Type 15KHz -->
    <switches default="7A">
        <dip name="Skip Post" bits="7" ids="On,Off"/>
        <dip name="Screen Flip (H)" bits="6" ids="On,Off"/>
        <dip name="Screen Flip (V)" bits="5" ids="On,Off"/>
        <dip name="Harness" bits="2" ids="JAMMA,JVS"/>
        <dip name="Monitor Type" bits="0" ids="15KHz,24KHz"/>
    </switches>

    <buttons names="Power Up,Shot,Missile,Start,Coin,Service,Test" default="A,B,X,Start,Select,R,L"/>
</misterromdescription>
